{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "减重训练风险闭环领域事件",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "aggregate_type",
    "aggregate_id",
    "occurred_at",
    "version",
    "summary"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "event_type": {
      "type": "string",
      "enum": [
        "PROMISE_PUBLISHED",
        "CONTRACT_SIGNED",
        "EVIDENCE_HELD",
        "REFUND_APPROVED",
        "REGULATORY_RESPONSE_FILED"
      ]
    },
    "aggregate_type": {
      "type": "string",
      "enum": [
        "marketing_promise",
        "service_contract",
        "dispute_case",
        "refund_entry"
      ]
    },
    "aggregate_id": {
      "type": "string",
      "minLength": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": true
}
